# python / env
.venv/
__pycache__/
*.pyc
.env

# os
.DS_Store

# video files, anywhere in the project
*.mp4
*.MP4
*.mov
*.MOV
*.m4v
*.M4V
*.avi
*.mkv
*.webm

# raw footage: keep the folders + readmes, ignore everything else (subfolders too)
/inputs/*/*
!/inputs/*/README.txt
!/inputs/*/.gitkeep

# old layout (before inputs/ existed). delete these folders once their clips are moved:
# python scripts/migrate_layout.py
/input/*
!/input/README.txt
/input_shop/*
!/input_shop/README.txt
/input_vlog/*
!/input_vlog/README.txt
/input_trial/*
!/input_trial/README.txt

# generated work files and other people's reels
/work/*
!/work/.gitkeep
/references/*
!/references/README.txt
!/references/.gitkeep

# finished reels, previews, covers (captions.md is hand-written, keep it)
/output/*
!/output/.gitkeep
!/output/trial/
/output/trial/*
!/output/trial/captions.md

# music (big + licensing). sfx are small, so they are tracked
/assets/music/*
!/assets/music/README.txt
!/assets/music/.gitkeep

# b-roll previews are rebuilt by: python -m engine broll index --brand <brand>
# (library.json is tracked: it holds hand-written descriptions the script can't recreate)
/brands/*/broll/_previews/*
!/brands/*/broll/_previews/.gitkeep
